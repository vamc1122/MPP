*&---------------------------------------------------------------------*
*&      Module  AT_EXIT_9000  INPUT
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
MODULE at_exit_9000 INPUT.
  gs_okcode = sy-ucomm.
  lv_year = sy-datum+0(4).
  CLEAR okcode.
  CASE gs_okcode.
    WHEN 'BACK' OR 'CANCEL'.
      LEAVE PROGRAM.
    WHEN 'EXIT'.
      LEAVE PROGRAM.
    WHEN 'GO'.
      REFRESH : it_gatep_tran.
      CLEAR: wa_gatep_tran.
      IF r_out = 'X'.
        wa_gatep_tran-posting_date = sy-datum.
        wa_gatep_tran-posting_time = sy-uzeit.
        wa_gatep_tran-outward_date = sy-datum.
        wa_gatep_tran-outward_time = sy-uzeit.

        CALL SCREEN '9001'.
      ELSEIF r_in = 'X'.
        wa_gatep_tran-posting_date = sy-datum.
        wa_gatep_tran-posting_time = sy-uzeit.
        wa_gatep_tran-inward_date = sy-datum.
        wa_gatep_tran-inward_time = sy-uzeit.

        CALL SCREEN '9002'.
      ELSEIF r_rgp = 'X'.
        wa_gatep_tran-posting_date = sy-datum.
        wa_gatep_tran-posting_time = sy-uzeit.
        wa_gatep_tran-inward_date = sy-datum.
        wa_gatep_tran-inward_time = sy-uzeit.

        CALL SCREEN '9003'.
      ELSEIF r_cancel = 'X'.
        CALL SCREEN '9004'.
      ELSEIF r_print = 'X'.
        CALL SCREEN '9005'.
      ENDIF.
  ENDCASE.
ENDMODULE.
