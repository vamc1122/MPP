*&---------------------------------------------------------------------*
*&  Include           ZIN20_GATEPASS_OUTWARD_F01
*&---------------------------------------------------------------------*
*&---------------------------------------------------------------------*
*&      Form  UPDATE_TABLE
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*  -->  p1        text
*  <--  p2        text
*----------------------------------------------------------------------*
FORM update_table.
  DELETE it_gatep_tran WHERE challan_no IS INITIAL.

*  IF it_gatep_tran IS NOT INITIAL.
  IF wa_gatep_tran IS NOT INITIAL.
    CALL FUNCTION 'NUMBER_GET_NEXT'
      EXPORTING
        nr_range_nr             = '01'
        object                  = 'ZGOUT'
        quantity                = '1'
        toyear                  = lv_year
      IMPORTING
        number                  = lv_number
      EXCEPTIONS
        interval_not_found      = 1
        number_range_not_intern = 2
        object_not_found        = 3
        quantity_is_0           = 4
        quantity_is_not_1       = 5
        interval_overflow       = 6
        buffer_overflow         = 7
        OTHERS                  = 8.
    IF sy-subrc <> 0.
* Implement suitable error handling here
      MESSAGE ID sy-msgid TYPE 'I' NUMBER sy-msgno WITH sy-msgv1 sy-msgv2 sy-msgv3 sy-msgv4 DISPLAY LIKE 'E'.
      LEAVE TO CURRENT TRANSACTION.
    ENDIF.
    IF r_out = 'X' AND lv_number IS NOT INITIAL.
      CONCATENATE 'OUT' lv_number INTO lv_gatepass.
      wa_gatep_tran-gate_pass_no = lv_gatepass.
*    ENDIF.
      wa_gatep_tran-entry_date = sy-datum.
      wa_gatep_tran-entry_time = sy-uzeit.
      wa_gatep_tran-entry_by = sy-uname.
      wa_gatep_tran-gyear = sy-datum+0(4).

      IF it_gatep_tran IS NOT INITIAL.

        MOVE-CORRESPONDING wa_gatep_tran TO wa_gatep_tran1.
        MODIFY it_gatep_tran FROM  wa_gatep_tran1
            TRANSPORTING gate_pass_no
                         gyear
                         plant
                         posting_date
                         posting_time
                         mode_of_tran
                         lr_rr_no
                         transport_code
                         transport_name
                         transporter_no
                         driver_name
                         driver_no
                         vehicle_no
                         inward_date
                         inward_time
                         reporting_loc
                         loading_loc
                         description
                         vendor_code
                         vendor_name
                         outward_date
                         outward_time
                         no_series
                         entry_date
                         entry_time
                         entry_by
        WHERE challan_no IS NOT INITIAL.
        CLEAR: lv_item.
        LOOP AT it_gatep_tran INTO wa_gatep_tran1.
          MOVE-CORRESPONDING wa_gatep_tran1 TO wa_gatep_tran.

          lv_item = lv_item + 10.
          wa_gatep_tran-gpass_itemno = lv_item.
          wa_gatep_tran-item_no = lv_item.
          MODIFY zin20_gatep_tran FROM wa_gatep_tran.
          IF sy-subrc = 0.
            COMMIT WORK AND WAIT.
            lv_skip = 'X'.
          ELSE.
            ROLLBACK WORK.
          ENDIF.
          CLEAR :wa_gatep_tran1,wa_gatep_tran.
        ENDLOOP.
      ENDIF.

      IF it_gatep_tran IS INITIAL AND wa_gatep_tran IS NOT INITIAL.
        lv_item = lv_item + 10.
        wa_gatep_tran-gpass_itemno = lv_item.
        wa_gatep_tran-item_no = lv_item.
        MODIFY zin20_gatep_tran FROM wa_gatep_tran.
        IF sy-subrc = 0.
          COMMIT WORK AND WAIT.
          lv_skip = 'X'.
        ELSE.
          ROLLBACK WORK.
        ENDIF.
        CLEAR :wa_gatep_tran1,wa_gatep_tran.
      ENDIF.


      IF lv_skip = 'X'.
        REFRESH : it_gatep_tran.
        CONCATENATE 'Outward Gate Pass No' lv_gatepass 'Created Successfully' INTO DATA(lv_msg) SEPARATED BY ' '.
        MESSAGE lv_msg TYPE 'I'.
        LEAVE TO SCREEN 0.
        CLEAR: lv_skip.
      ENDIF.

    ENDIF.
  ENDIF.
ENDFORM.

*&---------------------------------------------------------------------*
*&      Module  TRAN_F4HELP  INPUT
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
MODULE tran_f4help INPUT.
  REFRESH : lt_9002,lt_90021.
  SELECT a~kunnr b~name1 FROM knb1 AS a INNER JOIN kna1 AS b ON a~kunnr = b~kunnr
     INTO TABLE lt_9002 WHERE bukrs = 'IN20'.
  SELECT a~lifnr b~name1 FROM lfb1 AS a INNER JOIN lfa1 AS b ON a~lifnr = b~lifnr
    INTO TABLE lt_90021 WHERE bukrs = 'IN20'.
  APPEND LINES OF lt_90021 TO lt_9002.
  SORT lt_9002 BY transporter_code.
  DELETE ADJACENT DUPLICATES FROM lt_9002 COMPARING transporter_code.


  IF lt_9002 IS NOT INITIAL.
*
    CLEAR : return_tab,field_tab.
*-- Attaching F4 Help
    CALL FUNCTION 'F4IF_INT_TABLE_VALUE_REQUEST'
      EXPORTING
        retfield        = 'TRANSPORTER_CODE'
        dynpprog        = sy-cprog
        dynpnr          = '9001'
*       dynprofield     = 'GWA_ZTIY_WB_H-TRUCK_NO'
        value_org       = 'S'
      TABLES
        value_tab       = lt_9002
        field_tab       = field_tab
        return_tab      = return_tab
      EXCEPTIONS
        parameter_error = 1
        no_values_found = 2
        OTHERS          = 3.

    IF sy-subrc EQ 0.
      READ TABLE return_tab INTO DATA(ls_return_tab) INDEX 1.
      IF sy-subrc = 0.
        wa_gatep_tran-transport_code = ls_return_tab-fieldval.
        CALL FUNCTION 'CONVERSION_EXIT_ALPHA_INPUT'
          EXPORTING
            input  = wa_gatep_tran-transport_code
          IMPORTING
            output = wa_gatep_tran-transport_code.
      ENDIF.
    ENDIF.
  ENDIF.
ENDMODULE.
*&---------------------------------------------------------------------*
*&      Module VENDOR_F4HELP  INPUT
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
MODULE vendor_f4help INPUT.
  REFRESH : lt_9002,return_tab,field_tab.
  SELECT a~lifnr b~name1 FROM lfb1 AS a INNER JOIN lfa1 AS b ON a~lifnr = b~lifnr
